    "ledIndexNote": "LED n sits under key n, so the lighting array and the key array are indexed identically. That is a deliberate constraint: any per-key effect becomes a one-line lookup instead of a mapping table.",
    "board": {
      "name": "Waveshare RP2040-Zero",
      "mcu": "RP2040, dual Cortex-M0+ @ 133 MHz",
      "ram": "264 kB",
      "flash": "2 MB",
      "headerPins": "23 on the main castellated header: 5V, GND, 3V3, then 20 GPIO (GP0-GP15 and GP26-GP29)",
      "notOnMainHeader": "GP16 drives the board's own onboard WS2812. GP17-GP25 are on two 5-pin headers on the back and on solder pads, and are unused here",
      "headerNumbering": "USB-C up, front/component side facing you, pin 1 = 5V at top-left, counter-clockwise: left column 1-11 top to bottom (5V, GND, 3V3, GP29, GP28, GP27, GP26, GP15, GP14, GP13, GP12), right column 12-23 bottom to top (GP11, GP10, GP9, GP8, GP7, GP6, GP5, GP4, GP3, GP2, GP1, GP0)",
      "spareHeaderGpio": "GP13, GP14, GP15, GP26, GP27 - and GP26-GP29 are the ADC-capable pins, left free on purpose",
      "configSectors": "0x1FE000 and 0x1FF000 - the last two 4 KiB sectors of the 2 MB flash"
    },
    "oled": {
      "sda": {
        "gpio": 28,
        "headerPin": 5
      },
      "scl": {
        "gpio": 29,
        "headerPin": 4
      },
      "present": false,
      "bus": "i2c0",
      "address": "0x3C"
    }
  }
