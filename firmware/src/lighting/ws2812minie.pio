; ws2812minie.pio — 9 SK6812MINI-E LEDs, GRB MSB first through a
; NON-INVERTING 74AHCT1G125 (A -> Y, /OE tied LOW).
;
; Timing is for Normand SK6812MINI-E Rev.02, section 12:
; https://www.normandled.com/upload/202004/SK6812MINI-E%20LED%20Datasheet.pdf
; At a 10 MHz PIO clock, each instruction cycle is 100 ns. BOTH bit paths
; take 13 cycles = 1.30 us (datasheet minimum symbol period 1.20 us):
;
;   0: out 6c low, jmp 3c high, nop 4c low, then next out 6c low
;      T0H = 300 ns (200..400); T0L = 1000 ns (>=800, <20000)
;   1: out 6c low, jmp 3c high, jmp 4c high -> next out 6c low
;      T1H = 700 ns (580..1000); T1L = 600 ns (>=200, <20000)
;
; The zero-bit branch skips the one-only high instruction. The one-bit jump
; loops directly to the next out; the zero-bit nop reaches .wrap. Unlike the
; previous loop, neither path uses an out-of-spec short zero-bit period.
; A jmp's delay applies even when the branch is not taken, and the next bit's
; initial low run belongs to the previous bit's measured T0L/T1L.
;
; One 32-bit FIFO word per pixel. Shift LEFT 24 bits, so the caller must place
; GRB in bits 31..8 (word GGRRBB00); the bottom byte is discarded on autopull.
; With no next DMA word the out stalls with side 0: the pin idles LOW. The
; datasheet requires >80 us of low to latch; leds.c waits for the FIFO to drain
; and allows a final pixel plus a guarded reset interval before another frame.
; Only a bench measurement can validate the actual output and LED variant.

.program ws2812minie
.side_set 1

.wrap_target
bitloop:
    out x, 1          side 0 [5]  ; 6c low; can stall LOW on an empty TX FIFO
    jmp !x do_zero    side 1 [2]  ; 3c high for both bit values
    jmp bitloop       side 1 [3]  ; bit 1: 4c more high, then next bit
do_zero:
    nop               side 0 [3]  ; bit 0: 4c low, then wrap to next bit
.wrap

% c-sdk {
static inline void ws2812minie_program_init(PIO pio, uint sm, uint offset, uint pin,
                                            float freq_div) {
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_config c = ws2812minie_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_out_shift(&c,
                            /*shift_right=*/false,  // MSB first: bits 31..8 of each word
                            /*autopull=*/true,
                            /*pull_threshold=*/24);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, freq_div);
    pio_sm_init(pio, sm, offset, &c);

    /* GP10 drives buffer A, and the 74AHCT1G125 passes A to Y without
     * inversion. OE is a GPIO output-enable override, NOT the buffer's /OE:
     * both GPIO overrides must be NORMAL. The buffer's /OE is hardwired LOW. */
    gpio_set_oeover(pin, GPIO_OVERRIDE_NORMAL);
    gpio_set_outover(pin, GPIO_OVERRIDE_NORMAL);
    pio_sm_set_enabled(pio, sm, true);
}
%}
