# ─────────────────────────────────────────────────────────────────────────────
# Host test build. Compiles the SAME firmware sources with gcc on your PC, with
# the hardware layers stubbed out by preprocessor guards:
#
#   SCAN_NO_HW      -> scan.c returns injected samples instead of reading GPIO
#   LEDS_NO_HW      -> leds.c keeps the colour maths, drops PIO/DMA
#   STORAGE_NO_HW   -> flash_store.c models two sectors in RAM
#   HID_DEV_NO_HW   -> hid_dev.c records reports instead of sending them
#   USB_PROTO_NO_HW -> usb_proto.c skips CDC; inject/drain drive it directly
#
# Nothing here needs pico-sdk, cmake, or an ARM toolchain. That is deliberate:
# `make -f Makefile.host test-both` checks gated + bench variants in a plain
# container. Both firmware variants and both target LED driver branches run.
#
#   make -f Makefile.host test-both   build and run gated + bench unit tests
#   make -f Makefile.host clean
# ─────────────────────────────────────────────────────────────────────────────

CC      ?= gcc
BUILD   := build-host
LED_BENCH ?= 0
KEYS_ONLY ?= 0
CFLAGS  := -std=gnu11 -g -O1 -Wall -Wextra -Wno-unused-parameter -Wshadow \
           -Ifirmware/include -Iinclude -Itests -Ifirmware/tests \
           -DSCAN_NO_HW -DLEDS_NO_HW -DSTORAGE_NO_HW -DHID_DEV_NO_HW \
           -DUSB_PROTO_NO_HW -DOLED_NO_HW
ifeq ($(KEYS_ONLY),1)
CFLAGS += -DBOARD_KEYS_ONLY=1
endif
ifeq ($(LED_BENCH),1)
CFLAGS += -DBOARD_LED_OUTPUT_ENABLED=1
endif
LDFLAGS :=

SRC := \
  src/core/actions.c \
  src/core/ascii_cmd.c \
  src/core/channel.c \
  src/core/crc.c \
  src/core/dispatch.c \
  src/core/events.c \
  src/core/gesture.c \
  src/core/oled_playlist.c \
  src/core/oled_stream.c \
  src/core/protocol.c \
  src/drivers/oled.c \
  src/drivers/oled_frames.c \
  src/drivers/oled_runtime.c \
  src/drivers/scan.c \
  src/lighting/leds.c \
  src/storage/config_defaults.c \
  src/storage/config_store.c \
  src/storage/flash_store.c \
  src/usb/hid_dev.c \
  src/usb/usb_proto.c

TEST_SRC := \
  tests/test_main.c \
  tests/test_gesture.c \
  tests/test_scan.c \
  tests/test_config.c \
  tests/test_actions.c \
  tests/test_keyboard_hold.c \
  tests/test_ascii_cmd.c \
  tests/test_leds.c \
  tests/test_protocol.c \
  tests/test_oled.c \
  tests/test_oled_playlist.c \
  tests/test_oled_stream.c

OBJ      := $(addprefix $(BUILD)/,$(SRC:.c=.o))
TEST_OBJ := $(addprefix $(BUILD)/,$(TEST_SRC:.c=.o))
BIN      := $(BUILD)/run_tests
OLED_HW_BIN := $(BUILD)/test_oled_hw
LED_HW_BIN := $(BUILD)/test_led_hw
LED_HW_LOCKED_BIN := $(BUILD)/test_led_locked
HID_HW_BIN := $(BUILD)/test_hid_hw
LED_HW_PIO_HEADER := $(BUILD)/ws2812minie.pio.h
LEDVEC_BIN := $(BUILD)/dump_leds
LEDVEC_OUT := $(BUILD)/led-vectors.json
LAYOUT_BIN := $(BUILD)/dump_layout
LAYOUT_JSON := $(BUILD)/layout.json
DEFAULTS_BIN := $(BUILD)/dump_defaults
DEFAULTS_OUT := $(BUILD)/defaults.bin

.PHONY: all test test-both layout defaults ledvectors hostartifacts clean
all: $(BIN)

$(BIN): $(OBJ) $(TEST_OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $^ -o $@ $(LDFLAGS)

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(LEDVEC_BIN): $(OBJ) $(BUILD)/tests/dump_leds.o
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $^ -o $@ $(LDFLAGS)

# Scenario dump for the TypeScript port of the LED engine (tests/ledEngine.test.cjs).
ledvectors: $(LEDVEC_BIN)
	$(LEDVEC_BIN) > $(LEDVEC_OUT)
	@echo "wrote $(LEDVEC_OUT)"

# Compile the production I2C half without OLED_NO_HW against a fake Pico SDK.
# This catches pin/init/byte-order/NACK mistakes that canvas-only tests cannot.
$(OLED_HW_BIN): src/drivers/oled.c src/drivers/oled_frames.c tests/test_oled_hw.c \
                 tests/stubs/hardware/i2c.h tests/stubs/pico/stdlib.h
	@mkdir -p $(dir $@)
	$(CC) -std=gnu11 -Wall -Wextra -Werror -Itests/stubs -Iinclude \
	  src/drivers/oled.c src/drivers/oled_frames.c tests/test_oled_hw.c -o $@

# Host test of the *production* LED hardware branch, without LEDS_NO_HW. The
# header is generated from the actual .pio % c-sdk block, not a copied init:
# the Python timing simulator checks the PIO instructions separately.
$(LED_HW_PIO_HEADER): src/lighting/ws2812minie.pio ../tools/gen_led_pio_test_header.py
	@mkdir -p $(dir $@)
	@python3 ../tools/gen_led_pio_test_header.py > $@

$(LED_HW_BIN): src/lighting/leds.c tests/test_led_hw.c $(LED_HW_PIO_HEADER) \
               tests/stubs/hardware/pio.h tests/stubs/hardware/dma.h \
               tests/stubs/hardware/clocks.h tests/stubs/hardware/irq.h \
               tests/stubs/pico/stdlib.h
	@mkdir -p $(dir $@)
	$(CC) -std=gnu11 -Wall -Wextra -Werror -Wshadow -DBOARD_LED_OUTPUT_ENABLED=1 \
	  -I$(BUILD) -Itests/stubs -Iinclude \
	  src/lighting/leds.c tests/test_led_hw.c -o $@

# This compiles the *target* default GPIO gate without LEDS_NO_HW. Fail if
# show ever clocks PIO or raises data; even a nominal black frame isn't enough.
$(LED_HW_LOCKED_BIN): src/lighting/leds.c tests/test_led_locked.c \
                     tests/stubs/pico/stdlib.h
	@mkdir -p $(dir $@)
	$(CC) -std=gnu11 -Wall -Wextra -Werror -Wshadow -DBOARD_LED_OUTPUT_ENABLED=0 \
	  -Itests/stubs -Iinclude src/lighting/leds.c tests/test_led_locked.c -o $@

# Compile the production TinyUSB HID path (not HID_DEV_NO_HW) against a fake
# per-interface endpoint, including complete/failed callbacks and BOOTSEL drain.
$(HID_HW_BIN): src/usb/hid_dev.c src/core/actions.c src/core/channel.c tests/test_hid_hw.c tests/stubs/tusb.h \
               tests/stubs/bsp/board_api.h tests/stubs/hardware/flash.h \
               tests/stubs/hardware/watchdog.h tests/stubs/pico/bootrom.h \
               tests/stubs/pico/stdlib.h
	@mkdir -p $(dir $@)
	$(CC) -std=gnu11 -Wall -Wextra -Werror -Wshadow -Itests/stubs -Iinclude \
	  src/usb/hid_dev.c src/core/actions.c src/core/channel.c tests/test_hid_hw.c -o $@

test: $(BIN) $(OLED_HW_BIN) $(LED_HW_BIN) $(LED_HW_LOCKED_BIN) $(HID_HW_BIN)
	@./$(BIN)
	@./$(OLED_HW_BIN)
	@./$(LED_HW_BIN)
	@./$(LED_HW_LOCKED_BIN)
	@./$(HID_HW_BIN)

# A separate object tree avoids silently linking stale default-mode objects.
test-both: test
	@$(MAKE) -f Makefile.host BUILD=build-host-bench LED_BENCH=1 test

# Emit the real compiled struct layout for host/tests/run.mjs to check the
# protocol spec against. See tests/dump_layout.c for why this exists.
$(LAYOUT_BIN): tests/dump_layout.c $(OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $^ -o $@ $(LDFLAGS)

layout: $(LAYOUT_BIN)
	@./$(LAYOUT_BIN) > $(LAYOUT_JSON)
	@echo "wrote $(LAYOUT_JSON)"

$(DEFAULTS_BIN): tests/dump_defaults.c $(OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $^ -o $@ $(LDFLAGS)

# The firmware's own factory config, as bytes, for the host suite to diff against
# its JavaScript equivalent. See tests/dump_defaults.c.
defaults: $(DEFAULTS_BIN)
	@./$(DEFAULTS_BIN) > $(DEFAULTS_OUT)
	@echo "wrote $(DEFAULTS_OUT) ($$(wc -c < $(DEFAULTS_OUT)) bytes)"

# Everything host/tests/run.mjs needs.
hostartifacts: layout defaults

clean:
	rm -rf $(BUILD)

# The dump needs the same sources as the tests (config_defaults for the blob
# definition, crc for validation) but not the test cases themselves.

-include $(OBJ:.o=.d) $(TEST_OBJ:.o=.d)

# Separate object tree for the actual keys-only protocol configuration.
.PHONY: test-keys-only
test-keys-only:
	@$(MAKE) -f Makefile.host BUILD=build-host-keys KEYS_ONLY=1 keys-only-check

.PHONY: keys-only-check
keys-only-check: $(OBJ) $(BUILD)/tests/test_keys_only.o
	$(CC) $(CFLAGS) $^ -o $(BUILD)/test_keys_only
	./$(BUILD)/test_keys_only
	$(CC) -std=gnu11 -Wall -Wextra -Werror -ffunction-sections -fdata-sections \
	  -DBOARD_KEYS_ONLY=1 -Itests/stubs -Iinclude src/lighting/leds.c \
	  src/drivers/oled.c tests/test_keys_only_hw.c -Wl,--gc-sections -o $(BUILD)/test_keys_only_hw
	./$(BUILD)/test_keys_only_hw
	@if $(CC) $(CFLAGS) -DBOARD_LED_OUTPUT_ENABLED=1 -c tests/test_keys_only_hw.c -o $(BUILD)/invalid.o > /dev/null 2>&1; then \
	  echo "ERROR: keys-only build accepted LED output"; rm -f $(BUILD)/invalid.o; exit 1; \
	else echo "keys-only build rejects LED output"; fi
